# ╔══════════════════════════════════════════════════════════════════════════╗
# ║   J.A.R.V.I.S v17.M — Environment Configuration Template              ║
# ║   Copy this file to .env and fill in your real values.                 ║
# ║   ⚠  NEVER commit .env to GitHub  ⚠                                    ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── AI API Keys ────────────────────────────────────────────────────────────
# Get your Groq key at: https://console.groq.com/keys
GROQ_KEY=your_groq_api_key_here

# Get your Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key_here

# Get your OpenRouter key at: https://openrouter.ai/keys
OPENROUTER_KEY=your_openrouter_api_key_here

# Get your OpenWeatherMap key at: https://openweathermap.org/api
# (Optional — falls back to wttr.in if not set)
WEATHER_KEY=your_openweathermap_api_key_here

# ── Database ───────────────────────────────────────────────────────────────
# LOCAL dev (SQLite — zero config):
DB_BACKEND=sqlite

# Neon (app uses pooled URL; migrations use direct URL):
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# ── Security ───────────────────────────────────────────────────────────────
# local = password + TOTP session login for development
# clerk = Clerk bearer-token authentication
AUTH_MODE=local
# Production requires AUTH_MODE=clerk unless ALLOW_LOCAL_AUTH=1 is an explicit exception.
ALLOW_LOCAL_AUTH=0
# Flask SECRET_KEY is auto-generated and stored in DB — no need to set manually
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=https://your-landing-origin.example
# Generate with: py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=generate_a_unique_fernet_key_for_this_backend
# Optional previous Fernet key during a rotation; remove after rotating stored keys.
API_KEY_ENCRYPTION_KEY_OLD=
# Server-wide provider-key fallback is disabled unless explicitly set to 1.
SERVER_FALLBACK_KEYS=

# ── Paired device ──────────────────────────────────────────────────────────
DEVICE_ID=pc-primary

# ── Server ─────────────────────────────────────────────────────────────────
# Development binds to loopback. Public binds are refused unless explicitly enabled.
JARVIS_HOST=127.0.0.1
ALLOW_PUBLIC_BIND=0
JARVIS_PORT=5000
JARVIS_DEBUG=false
LOG_LEVEL=INFO

# ── Discord (optional) ─────────────────────────────────────────────────────
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_here
