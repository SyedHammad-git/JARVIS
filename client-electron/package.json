{
  "name": "jarvis-device-client",
  "version": "18.0.0",
  "description": "J.A.R.V.I.S Windows device client",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set JARVIS_DEV=1&& electron .",
    "test": "node --test test/client.test.js",
    "test:camera": "jest --runInBand test/jest/camera.spec.js",
    "dist": "electron-builder --win nsis && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/checksum.ps1"
  },
  "dependencies": {
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jest": "^30.2.0"
  },
  "build": {
    "appId": "com.jarvis.deviceclient",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "JARVIS-Device-Client-Setup-${version}.${ext}",
      "icon": "src/ui/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false
    }
  }
}
