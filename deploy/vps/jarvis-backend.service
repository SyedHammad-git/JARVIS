[Unit]
Description=JARVIS Cloud Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/backend-cloud
EnvironmentFile=/etc/jarvis/backend.env
Environment=JARVIS_ENV=production
Environment=DB_BACKEND=postgres
Environment=PORT=8000
Environment=JARVIS_DATA_DIR=/var/lib/jarvis
Environment=AUTH_MODE=clerk
Environment=AUTH_ENABLED=1
Environment=SERVER_FALLBACK_KEYS=0
Environment=TRUSTED_PROXY_HOPS=1
ExecStart=/opt/jarvis/venv/bin/gunicorn --config gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jarvis

[Install]
WantedBy=multi-user.target
